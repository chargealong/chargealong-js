{
  "name": "@chargealong/client",
  "version": "0.1.2",
  "description": "Find EV chargers near a point, plan a road trip through charging stops, and look up electric car charging speeds. Free and keyless.",
  "keywords": [
    "ev charger api",
    "ev charging stations",
    "charging station locator",
    "ev trip planner",
    "electric vehicle",
    "ev charging speed",
    "open charge map",
    "australia",
    "typescript"
  ],
  "license": "MIT",
  "homepage": "https://chargealong.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chargealong/chargealong-js.git"
  },
  "bugs": {
    "url": "https://github.com/chargealong/chargealong-js/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1"
  }
}
